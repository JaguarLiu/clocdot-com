:8080 {
	# API 先比對；handle 之間互斥，避免靜態檔的 try_files 把 /api/* 改寫掉
	handle /api/* {
		reverse_proxy server:3000
	}

	# SPA：找不到實體檔就回 index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Security headers (P1-4)
	# - connect-src 允許 https:：API 部署在獨立網域時需要（見 VITE_API_BASE）
	# - img-src 允許 https:：員工頭像為外部 URL
	# - admin 不需要 geolocation
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
