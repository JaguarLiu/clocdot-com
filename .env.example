# Copy this file to server/.env for local API development.
DATABASE_URL="postgresql://clocdot:clocdot_dev_only@localhost:5433/clocdot?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000

# Optional services
REDIS_URL="redis://localhost:6379"
GOOGLE_MAPS_API_KEY=""
RESEND_API_KEY=""
NOTIFY_FROM=""
NOTIFY_TO=""
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# 只有位於反向代理後面時才可信任 X-Forwarded-For（request.ip 是 Wi-Fi 打卡的判準）。
# 未設定 = 不信任；數字 = 反向代理跳數；也可填逗號分隔的 proxy IP/CIDR。
TRUST_PROXY=""
APPLY_DAILY_CAP_PER_IP=5
APPLY_GLOBAL_DAILY_CAP=100

# Frontend build-time values (put these in client/.env or admin/.env as needed)
VITE_API_BASE="/api"
VITE_ADMIN_URL="http://localhost:5174"
VITE_CLIENT_URL="http://localhost:5173"

# One-time administrator bootstrap (used by `npm run bootstrap:admin`)
# BOOTSTRAP_COMPANY_NAME="Example Company"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_NAME="System Administrator"
# For non-interactive automation only; prefer the hidden terminal prompt.
# BOOTSTRAP_ADMIN_PASSWORD=""
