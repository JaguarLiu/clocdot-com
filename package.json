{
  "name": "clocdot",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "client",
    "server",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace @clocdot/client\" \"npm run dev --workspace @clocdot/server\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:client": "npm run dev --workspace @clocdot/client",
    "dev:server": "npm run dev --workspace @clocdot/server",
    "dev:admin": "npm run dev --workspace @clocdot/admin",
    "db:migrate": "npm run db:migrate --workspace @clocdot/server",
    "db:push": "npm run db:push --workspace @clocdot/server",
    "db:studio": "npm run db:studio --workspace @clocdot/server",
    "bootstrap:admin": "npm run bootstrap:admin --workspace @clocdot/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.22.0",
    "uuid": "^11.1.1"
  }
}
